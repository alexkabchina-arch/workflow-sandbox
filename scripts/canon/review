def is_docs(path: str) -> bool:
    p = PurePosixPath(path)
    # Инструкции агенту — без учёта регистра (на macOS `.Claude/` — тот же `.claude/`);
    # каталог документов — с точным: ошибка только в сторону лишнего ревью.
    lower = PurePosixPath(path.lower())
    if AGENT_DIR in lower.parts[:-1] or (lower.parts and lower.parts[0] == OWNER_DIR):
        return False
    if lower.name in AGENT_FILES or lower.parts[-3:] == PROFILE:
        return False
    if p.parts and p.parts[0] in DOC_DIRS:
        return True
    return p.suffix.lower() in DOC_SUFFIXES


def git_sha(*args: str) -> str:
    result = subprocess.run(["git", *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise UsageError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout.strip()


def reviewed_range(base: str) -> dict:
    """Что покрывает ревью `base...HEAD`: для сверки в `ship-finish`.

    Незакоммиченные правки — отказ: встроенный `/review` смотрит и их, и отчёт о `head` описал бы
    не тот код, что проверен.
    """
    if git_sha("status", "--porcelain", "--untracked-files=no"):
        raise UsageError("есть незакоммиченные правки отслеживаемых файлов: сначала коммит")
    return {
        "base": base,
        "base_sha": git_sha("merge-base", base, "HEAD"),
        "head": git_sha("rev-parse", "HEAD"),
    }


def changed_files(base: str) -> list[str]:
    # Без распознавания переименований: перенос скилла в `docs/` — это и удаление скилла.
    result = subprocess.run(
        ["git", "diff", "--name-only", "--no-renames", "-z", f"{base}...HEAD"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise UsageError(f"git diff {base}...HEAD: {result.stderr.strip()}")
    return [p for p in result.stdout.split("\0") if p]


class Unverified(Exception):
    """Чистая установка не подтверждена — причина для строки предупреждения; дальше ревью."""


def git_bytes(*args: str) -> bytes | None:
    result = subprocess.run(["git", *args], capture_output=True)
    return result.stdout if result.returncode == 0 else None


def read_lock(rev: str) -> dict | None:
    """Файлы `.canon.lock` коммита `rev` (путь → сумма); замка нет — None."""
    data = git_bytes("show", f"{rev}:{LOCK}")
    if data is None:
        return None
    try:
        lock = json.loads(data)
    except ValueError:
        raise Unverified(f"{LOCK} в {rev[:7]} — не JSON") from None
    files = lock.get("files") if isinstance(lock, dict) else None
    if not isinstance(files, dict) or not all(isinstance(v, str) for v in files.values()):
        raise Unverified(f"{LOCK} в {rev[:7]}: нет словаря files")
    return lock


def gh_json(path: str):
    try:
        result = subprocess.run(["gh", "api", path], capture_output=True, text=True)
    except OSError as exc:
        raise Unverified(f"не запустился gh ({exc})") from None
    if result.returncode != 0:
        raise Unverified(f"gh api {path}: {(result.stderr or result.stdout).strip()[-200:]}")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise Unverified(f"gh api {path}: ответ не JSON") from None


def origin_repo() -> str | None:
    """`owner/name` из адреса `origin` на GitHub (как записан в настройке); иначе None."""
    url = (git_bytes("config", "--get", "remote.origin.url") or b"").decode().strip()
    found = GITHUB_REPO.search(url)
    return found.group(1) if found else None


class Install:
    """Сверка замка `head` с тегом канона: файл под замком — blob дерева тега на GitHub.

    Блобы `git` сравниваются как есть: равный blob — тот же файл побайтно."""

    def __init__(self, base_sha: str, head: str):
        self.head = head
        lock = read_lock(head)
        if lock is None:
            raise Unverified(f"нет {LOCK} в {head[:7]}")
        self.files = lock["files"]
        self.old = (read_lock(base_sha) or {"files": {}})["files"]
        commit = lock.get("commit")
        if not isinstance(commit, str) or not COMMIT.fullmatch(commit):
            raise Unverified(f"{LOCK}: commit — не полный sha коммита")
        version = lock.get("version")
        self.version = version if isinstance(version, str) and VERSION.fullmatch(version) else None
        if self.version is None:
            raise Unverified(f"{LOCK}: версия — не имя тега или коммита")
        compare = gh_json(f"repos/{CANON_REPO}/compare/{commit}...{CANON_MAIN}")
        status = compare.get("status") if isinstance(compare, dict) else None
        if status not in ("ahead", "identical"):
            raise Unverified(f"коммит замка {commit[:12]} не в {CANON_MAIN} канона ({status})")
        self.trees: dict[tuple[str, str], dict[str, str]] = {}
        self.canon = self.tree(CANON_REPO, commit)
        self._matt: dict | None = None
        # Блобы `head` одним `ls-tree`, содержимое и итог сверки — по разу на файл.
        listing = git_bytes("ls-tree", "-r", "-z", head) or b""
        self.blobs, modes = {}, {}
        for line in filter(None, listing.decode(errors="surrogateescape").split("\0")):
            meta, _, rel = line.partition("\t")
            if meta.split()[1:2] == ["blob"]:
                self.blobs[rel], modes[rel] = meta.split()[2], meta.split()[0]
        self.contents: dict[str, bytes | None] = {}
        self.checked: dict[str, bool] = {}
        # Сам канон: проверка замка и перевод базы — файлы дерева тега (по blob с GitHub), а не
        # `head`: исходники в ветке могут быть новее тега.
        # Только в репозитории канона: проект со своей ссылкой выдал бы переведённую (более
        # узкую) базу за установку.
        self.self_mode = modes.get(SELF_LINK) == "120000" and origin_repo() == CANON_REPO
        if self.self_mode:
            self.checker = self.tag_module(CHECKER)
            self.sync = self.tag_module(SYNC, prefix="")
        else:
            if not self.from_tag(CHECKER):
                raise Unverified(f"{CHECKER} не совпадает с тегом {self.version}")
            self.checker = types.ModuleType("canon_check_lock")
            exec(compile(self.content(CHECKER) or b"", CHECKER, "exec"), self.checker.__dict__)

    def tag_bytes(self, path: str) -> bytes:
        """Файл дерева канона на коммите замка — по blob из дерева GitHub (git сверяет blob по
        содержимому); blob'а нет локально — не подтверждено."""
        blob = self.canon.get(path)
        data = git_bytes("cat-file", "blob", blob) if blob else None
        if data is None:
            raise Unverified(f"{path} тега {self.version} не прочитан")
        return data

    def tag_module(self, rel: str, prefix: str = CANON_PREFIX) -> types.ModuleType:
        module = types.ModuleType(f"canon_tag_{rel.replace('/', '_').replace('.', '_')}")
        try:
            exec(compile(self.tag_bytes(prefix + rel), rel, "exec"), module.__dict__)
        except Unverified:
            raise
        except Exception as exc:  # noqa: BLE001 — файл тега не загрузился: полное ревью
            raise Unverified(f"{rel} тега {self.version} не загрузился ({exc})") from None
        return module

    def tree(self, repo: str, ref: str) -> dict[str, str]:
        if (repo, ref) not in self.trees:
            data = gh_json(f"repos/{repo}/git/trees/{ref}?recursive=1")
            entries = data.get("tree") if isinstance(data, dict) else None
            if not isinstance(entries, list) or data.get("truncated"):
                raise Unverified(f"дерево {repo}@{ref[:12]} не получено целиком")
            self.trees[(repo, ref)] = {
                e["path"]: e["sha"]
                for e in entries
                if isinstance(e, dict) and e.get("type") == "blob"
            }
        return self.trees[(repo, ref)]

    def blob(self, rel: str) -> str | None:
        return self.blobs.get(rel)

    def content(self, rel: str) -> bytes | None:
        if rel not in self.contents:
            blob = self.blob(rel)
            self.contents[rel] = git_bytes("cat-file", "blob", blob) if blob else None
        return self.contents[rel]

    def from_tag(self, rel: str) -> bool:
        blob = self.blob(rel)
        return blob is not None and self.canon.get(CANON_PREFIX + rel) == blob

    def matt(self) -> dict:
        """Скиллы `matt-skills.lock.json` тега (файл в `head` — файл тега); иначе пусто."""
        if self._matt is None:
            self._matt = {}
            if self.from_tag(MATT_LOCK):
                try:
                    skills = json.loads(self.content(MATT_LOCK) or b"").get("skills")
                except (ValueError, AttributeError):
                    skills = None
                self._matt = skills if isinstance(skills, dict) else {}
        return self._matt

    def matt_source(self, rel: str) -> tuple[str, str, str] | None:
        """Репозиторий, коммит и путь файла скилла Мэтта в его репозитории; не скилл — None."""
        if not rel.startswith(SKILLS_DIR):
            return None
        name, _, rest = rel[len(SKILLS_DIR) :].partition("/")
        entry = self.matt().get(name)
        if not rest or not isinstance(entry, dict):
            return None
        source, ref, path = (entry.get(k) for k in ("source", "ref", "skillPath"))
        if not all(isinstance(x, str) for x in (source, ref, path)):
            return None
        if not COMMIT.fullmatch(ref) or not re.fullmatch(r"[\w.-]+/[\w.-]+", source):
            return None
        return source, ref, str(PurePosixPath(path).parent / rest)

    def base_ok(self, data: bytes | None) -> bool:
        """База настроек самого канона — база тега, переведённая `self_base` его `canon-sync`."""
        try:
            base = json.loads(self.tag_bytes(CANON_PREFIX + SETTINGS_BASE))
            return data == self.checker.render_json(self.sync.self_base(base))
        except Exception:  # noqa: BLE001 — тег до `self_base` (откат до #310) или сбой: ревью
            return False

    def settings_ok(self, data: bytes) -> bool:
        """`settings.json` — склейка базы тега и добавок проекта той же склейкой тега."""
        if self.self_mode:
            if not self.base_ok(self.content(SETTINGS_BASE)):
                return False
        elif not self.from_tag(SETTINGS_BASE):
            return False
        checker = self.checker
        additions = self.content(SETTINGS_PROJECT)
        try:
            base = json.loads(self.content(SETTINGS_BASE) or b"")
            built = checker.build_settings(base, json.loads(additions) if additions else None)
        except (ValueError, checker.MergeError):
            return False
        return built == data

    def verified(self, rel: str) -> bool:
        """Файл `rel` в `head` — под замком с его суммой и равен файлу тега."""
        if rel not in self.checked:
            self.checked[rel] = self.check(rel)
        return self.checked[rel]

    def check(self, rel: str) -> bool:
        if self.self_mode and not rel.startswith(SELF_PREFIX):
            return False  # в каноне `--self` ставит только `.claude/` — прочее ревьюится
        data = self.content(rel)
        if data is None or rel not in self.files:
            return False
        if self.checker.file_hash(data) != self.files[rel]:  # сумма — функцией тега
            return False
        if rel == SETTINGS:
            return self.settings_ok(data)
        if rel == SETTINGS_BASE and self.self_mode:
            return self.base_ok(data)
        if CANON_PREFIX + rel in self.canon:
            return self.from_tag(rel)
        source = self.matt_source(rel)
        return source is not None and self.tree(*source[:2]).get(source[2]) == self.blob(rel)

    def dropped(self, rel: str) -> bool:
        """Файл убран тегом: был в старом замке, нет в новом, в `head` и в тег не входит."""
        if self.content(rel) is not None or rel not in self.old or rel in self.files:
            return False
        if self.self_mode and not rel.startswith(SELF_PREFIX):
            return False
        if rel == SETTINGS or CANON_PREFIX + rel in self.canon:
            return False
        source = self.matt_source(rel)
        return source is None or source[2] not in self.tree(*source[:2])

    def lock_ok(self) -> bool:
        """Каждая новая или изменённая строка замка — файл тега, каждая убранная — убрана тегом."""
        changed = [rel for rel, digest in self.files.items() if self.old.get(rel) != digest]
        removed = [rel for rel in self.old if rel not in self.files]
        return all(map(self.verified, changed)) and all(map(self.dropped, removed))


def needs_review(files: list[str], base_sha: str, head: str) -> tuple[list[str], dict | None, str]:
    """Файлы кода диффа, которым нужно ревью; сведения о чистой установке (`version`, `files`
    без ревью) или None; причина, почему установка не подтверждена, или пустая строка.

    Правило одно для `review` и для перепроверки пропуска в `ship-finish`."""
    install, note, covered = None, "", set()
    if LOCK in files:
        try:
            check = Install(base_sha, head)
            if not check.lock_ok():
                raise Unverified(f"{LOCK} не сходится с тегом {check.version}")
            mine = {LOCK} | {p for p in files if check.verified(p) or check.dropped(p)}
            rest = [p for p in files if p not in mine and not is_docs(p)]
            if not all(SAFE_PATH.fullmatch(p) for p in rest):
                raise Unverified("имя файла кода не годится для списка ревью")
            covered, install = mine, {"version": check.version, "files": sorted(mine)}
        except Unverified as exc:
            note = str(exc)
    return [p for p in files if p not in covered and not is_docs(p)], install, note


def is_finding(item) -> bool:
    return isinstance(item, dict) and all(
        isinstance(item.get(key), str) and item[key].strip() for key in ("file", "summary")
    )


def tool_blocks(event: dict, kind: str) -> list[dict]:
    """Блоки `kind` (`tool_use`, `tool_result`) события верхнего уровня, не сабагента."""
    if event.get("parent_tool_use_id"):
        return []
    message = event.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    blocks = content if isinstance(content, list) else []
    return [b for b in blocks if isinstance(b, dict) and b.get("type") == kind]


def reported(events: list[dict]) -> list[dict] | None:
    """Находки принятых вызовов `ReportFindings` верхнего уровня, без повторов; нет их — None.

    Вход, отклонённый инструментом (`tool_result` с `is_error`), модель повторяет — такой вызов
    не считается (иначе находки задвоятся, живой прогон #70). Принятые вызовы склеиваются: модель
    может разнести находки по двум; одинаковые (`file`, `line`, `summary`) — один раз. Находки не
    по схеме пропускаются.
    """
    rejected = {
        block.get("tool_use_id")
        for event in events
        if event.get("type") == "user"
        for block in tool_blocks(event, "tool_result")
        if block.get("is_error")
    }
    result: dict[tuple, dict] = {}
    accepted = False
    for event in events:
        if event.get("type") != "assistant":
            continue
        for block in tool_blocks(event, "tool_use"):
            if block.get("name") != REPORT_TOOL or block.get("id") in rejected:
                continue
            given = block.get("input")
            found = given.get("findings") if isinstance(given, dict) else None
            if not isinstance(found, list):
                continue
            accepted = True
            for item in filter(is_finding, found):
                key = (item["file"].strip(), item.get("line"), item["summary"].strip())
                result.setdefault(key, item)
    return list(result.values()) if accepted and result else None


def until_answer(events: list[dict]) -> list[dict]:
    """События потока до принятого ответа по схеме включительно (`claude_run.last_result`).

    Лишний ход после ответа (ozon #947) может снова вызвать `ReportFindings` — его находки не
    идут ни в ответ, ни в отчёт: источник находок — один прогон, тот, чей ответ принят.
    """
    answered = [number for number, event in enumerate(events) if claude_run.is_answer(event)]
    return events[: answered[-1] + 1] if answered else events


def findings(data: dict, events: list[dict], report: Path) -> tuple[list[dict], str]:
    """Находки и их источник: оригинал `ReportFindings` до принятого ответа по схеме, иначе
    ответ по схеме (пересказ).

    Оригинала нет, а ответ по схеме не по ней — `ChildError`, ответ — в `.raw.md`.
    """
    original = reported(until_answer(events))
    if original is not None:
        return original, REPORT_TOOL
    output = data["structured_output"]
    items = output.get("findings")
    if isinstance(items, list) and all(is_finding(item) for item in items):
        return items, RETELLING
    raw = claude_run.sibling(report, ".raw.md")
    claude_run.write_text(raw, json.dumps(output, ensure_ascii=False, indent=2))
    raise claude_run.ChildError(
        "ответ не по схеме (нужен список findings, у каждой находки "
        f"непустые file и summary) — находки не распознаны; ответ — {raw}"
    )


def keep_reported(events: list[dict], report: Path) -> str:
    """Несостоявшийся прогон успел вызвать `ReportFindings` — оплаченные находки в `.raw.md`
    (до принятого ответа по схеме, если он был: хвост — не этого прогона)."""
    original = reported(until_answer(events))
    if original is None:
        return ""
    raw = claude_run.sibling(report, ".raw.md")
    raw.parent.mkdir(parents=True, exist_ok=True)  # поток мог оборваться до записи отчёта
    before = raw.read_text(encoding="utf-8") if raw.exists() else ""
    tail = f"\n\n## Последняя реплика\n\n{before}" if before.strip() else ""
    claude_run.write_text(raw, render(original) + tail)
    return f"; находки ReportFindings ({len(original)}) — в {raw}"


def weakening(output: dict) -> str:
    """Ответ на вопрос об ослаблении защиты: пустая строка — нет («Нет.» и подобное — тоже);
    не ответило — пометка."""
    answer = output.get("weakening")
    if not isinstance(answer, str):
        return NO_WEAKENING_ANSWER
    answer = answer.strip()
    return "" if answer.lower().rstrip(".!") in PLAIN_NO else answer


def render(items: list[dict], weakened: str | None = None) -> str:
    """Находки списком в markdown и ответ об ослаблении защиты (`None` — ответа ещё нет) — для
    `<отчёт>.md`."""
    tail = ""
    if weakened:
        tail = f"\n\n## Ослабление защиты\n\n{weakened}"
    elif weakened is not None:
        tail = "\n\nОслабления защиты нет."
    if not items:
        return "# Ревью ошибок\n\nНаходок нет." + tail
    lines = [f"# Ревью ошибок\n\nНаходок: {len(items)}.\n"]
    for number, item in enumerate(items, 1):
        line = item.get("line")
        where = f"{item['file']}:{line}" if isinstance(line, int) else item["file"]
        kind = item.get("category")
        # Нет категории — явная пометка, чтобы находка не выглядела оборванной; техдолг
        # `/ship` решает по сценарию вреда, не по тегу.
        tag = (
            f" ({kind.strip()})" if isinstance(kind, str) and kind.strip() else f" ({NO_CATEGORY})"
        )
        lines.append(f"{number}. `{where}`{tag} — {item['summary'].strip()}")
        scenario = item.get("failure_scenario")
        if isinstance(scenario, str) and scenario.strip():
            lines.append(f"   Сценарий: {scenario.strip()}")
    return "\n".join(lines) + tail


def run_review(
    report: Path, base: str, budget: str, scope: dict, only: list[str] | None = None
) -> dict:
    """Запускает ревью и сохраняет результат; возвращает блок `canon_review` отчёта.

    `only` — при чистой установке: ревьюить только эти файлы (версия — `scope["install"]`).

    Не состоялось (нет ответа по схеме, а без оригинала `ReportFindings` — и ответ не по схеме) —
    `ChildError`: отчёт без `canon_review`, отметки по нему нет.
    """
    events: list[dict] = []
    try:
        system = SUMMARY_LIMIT
        if only:
            listed = ", ".join(f"`{p}`" for p in only)
            version = scope["install"]["version"]
            system += "\n" + INSTALL_SCOPE.format(code=listed, version=version)
        limit = ["--append-system-prompt", system]
        data = claude_run.run_claude(
            [*limit, prompt(base)], report, budget, SCHEMA, events, env=CHILD_ENV
        )
        items, source = findings(data, events, report)
    except claude_run.ChildError as exc:
        kept = keep_reported(events, report)
        raise claude_run.ChildError(f"ревью не состоялось: {exc}{kept}") from None
    weakened = weakening(data["structured_output"])
    claude_run.write_text(report.with_suffix(".md"), render(items, weakened))
    verdict = claude_run.budget_verdict(data.get("total_cost_usd"), budget, "ревью стоило")
    data["canon_review"] = {
        **scope,
        "skipped": False,
        "findings": len(items),
        "findings_source": source,
        "weakening": weakened,
        **verdict,
        "trailing_warning": claude_run.trailing_warning(data),
    }
    claude_run.write_json(report, data)
    return data["canon_review"]


def write_skipped(report: Path, scope: dict, files: list[str]) -> None:
    """Отчёт о пропуске: по нему `ship-finish` ставит отметку «только документы»."""
    claude_run.set_aside(report)
    report.parent.mkdir(parents=True, exist_ok=True)
    claude_run.write_json(report, {"canon_review": {**scope, "skipped": True, "files": files}})


def main(argv: list[str] | None = None) -> int:
    args = claude_run.parser("review", __doc__.split("\n\n")[0]).parse_args(argv)
    try:
        files = changed_files(args.base)
        scope = reviewed_range(args.base)
        code, install, note = needs_review(files, scope["base_sha"], scope["head"])
        if note:
            print(
                f"review: предупреждение: чистая установка канона не подтверждена — {note}; "
                "ревью всех файлов кода"
            )
        if install:
            scope["install"] = install
        if not code:
            write_skipped(args.report, scope, files)
            what = (
                f"чистая установка канона {install['version']}" if install else "только документы"
            )
            print(
                f"review: пропущено — в {args.base}...HEAD {what} "
                f"(файлов: {len(files)}); отчёт — {args.report}"
            )
            return 0
        only = code if install else None
        result = run_review(args.report, args.base, args.max_budget_usd, scope, only)
    except UsageError as exc:
        print(f"review: {exc}", file=sys.stderr)
        return 2
    except claude_run.ChildError as exc:
        print(f"review: {exc}", file=sys.stderr)
        return 1
    cost = result["cost_usd"]
    print(
        f"review: /review {LEVEL} на {MODEL} готово (файлов кода: {len(code)}, "
        f"{'?' if cost is None else f'{cost:.2f}'} USD, находок: {result['findings']}); "
        f"находки — {args.report.with_suffix('.md')}"
    )
    if install:
        print(
            f"review: чистая установка канона {install['version']} — без ревью файлов: "
            f"{len(install['files'])}; ревью — только остальных"
        )
    if result["weakening"]:
        lines = [line.strip() for line in result["weakening"].splitlines() if line.strip()]
        print(f"review: ослабление защиты: {' / '.join(lines)}")
    if result["findings_source"] == RETELLING:
        print(
            f"review: предупреждение: находки — пересказ модели по схеме (вызова {REPORT_TOOL} "
            "в потоке нет): список мог сократиться"
        )
    if result["trailing_warning"]:
        print(f"review: предупреждение: {result['trailing_warning']}")
    if result["over_budget"]:
        print(f"review: предупреждение: {result['warning']}")
    if result["ready_for_human"]:
        print(
            f"review: ready-for-human: {result['warning']} — перерасход вдвое и больше, "
            "сессии тикета поставить ready-for-human с этой строкой"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
