#!/usr/bin/env python3
"""secrets — проверка `secrets` профиля: gitleaks по коммитам ветки после `origin/main` (#283).

    python3 <канон>/secrets          # из чекаута ветки; код — код gitleaks

Одна команда для всех трёх мест, где идёт проверка (шаг маршрута «тесты и линтеры»,
`ship-finish`, публикация head оркестратором): настройки gitleaks берутся не из ветки, иначе
ветка сама выключила бы проверку своих коммитов.

- **конфиг** — `.gitleaks.toml` из `origin/main` (временный файл), а не из рабочего дерева; в
  `origin/main` его нет — правила gitleaks по умолчанию (`[extend] useDefault`);
- **`.gitleaksignore` ветки не читается**: gitleaks ищет его в каталоге-источнике и по
  `--gitleaks-ignore-path` — источник здесь каталог git (`--source <git-dir>`, коммитом туда
  не положить), путь ignore — несуществующий файл;
- **`gitleaks:allow` в строках ветки не действует** (`--ignore-gitleaks-allow`).

Нет `origin/main` — код 1: gitleaks проверил бы 0 коммитов и вышел зелёным; конфиг в нём есть,
но не прочитан — тоже код 1, а не правила по умолчанию. Нет gitleaks на PATH — код 127.
Вывод — как у `gitleaks detect -v --redact` (находки разбирает `ticket_core`).
Файл вендорится из канона `alexkabchina-arch/workflow`: руками не править.
Только стандартная библиотека Python 3.
"""

from __future__ import annotations

import subprocess
import sys
import tempfile
from pathlib import Path

BASE = "origin/main"
CONFIG = ".gitleaks.toml"
DEFAULT_CONFIG = "[extend]\nuseDefault = true\n"


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True)


def main() -> int:
    if git("rev-parse", "--verify", "-q", BASE).returncode != 0:
        print(f"secrets: нет {BASE} — проверять не с чем", file=sys.stderr)
        return 1
    gitdir = git("rev-parse", "--absolute-git-dir")
    if gitdir.returncode != 0:
        print(f"secrets: не git-репозиторий: {gitdir.stderr.strip()}", file=sys.stderr)
        return 1
    listed = git("ls-tree", "--name-only", BASE, "--", CONFIG)
    shown = git("show", f"{BASE}:{CONFIG}") if listed.stdout.strip() else None
    if listed.returncode != 0 or (shown is not None and shown.returncode != 0):
        why = (shown or listed).stderr.strip()
        print(f"secrets: {CONFIG} из {BASE} не прочитан: {why}", file=sys.stderr)
        return 1
    with tempfile.TemporaryDirectory(prefix="canon-secrets-") as tmp:
        config = Path(tmp) / "gitleaks.toml"
        config.write_text(shown.stdout if shown else DEFAULT_CONFIG)
        cmd = [
            "gitleaks",
            "detect",
            "--source",
            gitdir.stdout.strip(),
            f"--log-opts={BASE}..HEAD",
            "--config",
            str(config),
            "--gitleaks-ignore-path",
            str(Path(tmp) / "no-gitleaksignore"),
            "--ignore-gitleaks-allow",
            "--redact",
            "-v",
            "--no-banner",
            "--no-color",
        ]
        try:
            return subprocess.run(cmd).returncode
        except FileNotFoundError:
            print("secrets: нет `gitleaks` на PATH (docs/secrets.md)", file=sys.stderr)
            return 127


if __name__ == "__main__":
    sys.exit(main())
