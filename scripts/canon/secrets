#!/usr/bin/env python3
"""secrets — проверка `secrets` профиля: gitleaks по коммитам ветки после `origin/main` (#283).

    python3 <канон>/secrets          # из чекаута ветки; код — код gitleaks

Одна команда для всех трёх мест, где идёт проверка (допуск маршрута,
`ship-finish`, публикация head оркестратором): настройки gitleaks берутся не из ветки, иначе
ветка сама выключила бы проверку своих коммитов.

- **конфиг** — `.gitleaks.toml` из `origin/main` (временный файл), а не из рабочего дерева; в
  `origin/main` его нет — правила gitleaks по умолчанию (`[extend] useDefault`);
- **`.gitleaksignore` ветки не читается**: gitleaks ищет его в каталоге-источнике и по
  `--gitleaks-ignore-path` — источник здесь каталог git (`--source <git-dir>`, коммитом туда
  не положить), путь ignore — несуществующий файл;
- **`gitleaks:allow` в строках ветки не действует** (`--ignore-gitleaks-allow`).

Те же настройки (`trusted_settings`) стандартный хук перед коммитом (#459) даёт строке `gitleaks`
быстрых проверок профиля основной ветки.

Нет `origin/main` — код 1: gitleaks проверил бы 0 коммитов и вышел зелёным; конфиг в нём есть,
но не прочитан — тоже код 1, а не правила по умолчанию. Нет gitleaks на PATH — код 127.
Вывод — как у `gitleaks detect -v --redact` (находки разбирает `ticket_core`).
Файл вендорится из канона `alexkabchina-arch/workflow`: руками не править.
Только стандартная библиотека Python 3.
"""

from __future__ import annotations

import subprocess
import sys
import tempfile
from pathlib import Path

BASE = "origin/main"
CONFIG = ".gitleaks.toml"
DEFAULT_CONFIG = "[extend]\nuseDefault = true\n"


class SettingsError(Exception):
    """Доверенные настройки gitleaks не собрать."""


def git(*args: str, cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, cwd=cwd)


def trusted_settings(tmp: Path, cwd: Path | None = None) -> tuple[list[str], str]:
    """Флаги gitleaks, которые не дают ветке выключить проверку: конфиг из `origin/main` (в
    `tmp`; нет его там — правила по умолчанию), несуществующий `.gitleaksignore`,
    `--ignore-gitleaks-allow`, и каталог git рабочей копии — источник (`.gitleaksignore` ищется
    и в нём). Итог — (флаги без источника, каталог git); не вышло — `SettingsError`. Зовёт и
    стандартный хук (`hooks/commit_checks.py`, #459) для строки `gitleaks` быстрых проверок."""
    if git("rev-parse", "--verify", "-q", BASE, cwd=cwd).returncode != 0:
        raise SettingsError(f"нет {BASE} — проверять не с чем")
    gitdir = git("rev-parse", "--absolute-git-dir", cwd=cwd)
    if gitdir.returncode != 0:
        raise SettingsError(f"не git-репозиторий: {gitdir.stderr.strip()}")
    listed = git("ls-tree", "--name-only", BASE, "--", CONFIG, cwd=cwd)
    shown = git("show", f"{BASE}:{CONFIG}", cwd=cwd) if listed.stdout.strip() else None
    if listed.returncode != 0 or (shown is not None and shown.returncode != 0):
        why = (shown or listed).stderr.strip()
        raise SettingsError(f"{CONFIG} из {BASE} не прочитан: {why}")
    config = tmp / "gitleaks.toml"
    config.write_text(shown.stdout if shown else DEFAULT_CONFIG)
    flags = [
        "--config",
        str(config),
        "--gitleaks-ignore-path",
        str(tmp / "no-gitleaksignore"),
        "--ignore-gitleaks-allow",
    ]
    return flags, gitdir.stdout.strip()


def main() -> int:
    with tempfile.TemporaryDirectory(prefix="canon-secrets-") as tmp:
        try:
            flags, gitdir = trusted_settings(Path(tmp))
        except SettingsError as exc:
            print(f"secrets: {exc}", file=sys.stderr)
            return 1
        cmd = [
            "gitleaks",
            "detect",
            "--source",
            gitdir,
            f"--log-opts={BASE}..HEAD",
            *flags,
            "--redact",
            "-v",
            "--no-banner",
            "--no-color",
        ]
        try:
            return subprocess.run(cmd).returncode
        except FileNotFoundError:
            print("secrets: нет `gitleaks` на PATH (docs/secrets.md)", file=sys.stderr)
            return 127


if __name__ == "__main__":
    sys.exit(main())
