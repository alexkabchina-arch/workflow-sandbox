#!/usr/bin/env python3
"""relay — хук пути v2 (#338): `relay <вид хука> [аргументы git…]`, вся логика — `v2/checks.py`.

Зовут его скрипты переходника `canon-hooks/` в worktree сессии (ставит `checks.install`): у
`pre-commit` — быстрые проверки, затем прежний хук проекта того же вида. Git зовёт хук из корня
worktree. Файл вендорится из канона `alexkabchina-arch/workflow`: руками не править. Только
стандартная библиотека Python 3.
"""

import sys
import types
from pathlib import Path

path = Path(__file__).resolve().parent.parent / "checks.py"
checks = types.ModuleType("canon_v2_checks_relay")
checks.__file__ = str(path)
exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), checks.__dict__)
sys.exit(checks.relay(sys.argv[1], sys.argv[2:], Path.cwd()))
