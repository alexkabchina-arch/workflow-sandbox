<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Образец службы оркестратора канона (#222) для launchd пользователя.
  Руками не ставить: `<копия канона>/project/scripts/canon/orchestrator service install` из
  главного чекаута проекта подставит Label, ProgramArguments, WorkingDirectory, логи и PATH и
  положит plist в ~/Library/LaunchAgents. Как устроено — docs/orchestrator.md канона.
  Интерпретатор службы — тот Python, что запустил `service install`: запускать его под
  Python 3.12 Homebrew (`/opt/homebrew/bin/python3.12 <копия>/project/scripts/canon/orchestrator
  service install`, #376), не системным 3.9; строку «служба: Python» проверяет `canon-release`.
  Файл вендорится из канона alexkabchina-arch/workflow: руками не править.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>canon.orchestrator</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3.12</string>
		<string>orchestrator</string>
		<string>tick</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/</string>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
	</dict>
</dict>
</plist>
