def open_inside(root: Path, parts: tuple[str, ...], make: bool = False) -> int:
    """Каталог клона песочницы — дескриптором, по одному звену без перехода по символическим
    ссылкам (`O_NOFOLLOW`): клон правит сессия, и каталог, подменённый ссылкой, увёл бы запись
    Mac в копию канона или в свой отчёт ревью. `make` — недостающие звенья создать."""
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in parts:
            if make:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
    except BaseException:
        os.close(fd)
        raise
    return fd


def read_inside(root: Path, rel: Path) -> bytes:
    """Файл клона песочницы — без перехода по ссылкам (`open_inside`), без ожидания (FIFO не
    повесит такт) и только обычный файл не больше `STATE_LIMIT`."""
    fd = open_inside(root, rel.parent.parts)
    try:
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        file = os.open(rel.name, flags, dir_fd=fd)
    finally:
        os.close(fd)
    with os.fdopen(file, "rb") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > STATE_LIMIT:
            raise OSError(f"{rel}: не обычный файл до {STATE_LIMIT // 1024} КБ")
        return source.read(STATE_LIMIT + 1)


