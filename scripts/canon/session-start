#!/usr/bin/env python3
"""session-start — старт сессии тикета: уборка, PR автора первыми, тикет, worktree, зависимости.

    scripts/canon/session-start <номер тикета> [--json]

Из любого worktree проекта. Сессию не запускает: готовит место и печатает, что запускать, —
поэтому годится и первым шагом внутри уже открытой сессии. Запуск `claude` — `session-run`.
По порядку:

1. Уборка: `git worktree prune`; для worktree из реестра сессий, которых больше нет, —
   проектная команда `scripts/session/cleanup <путь worktree>` из главного worktree. Успех —
   запись уходит из реестра; сбой — запись остаётся до следующего старта, старт продолжается,
   но заново занять этот путь нельзя, пока ресурсы не убраны. Нет команды — запись просто уходит.
   Реестр — `canon-sessions.json` в общем каталоге git, правится под блокировкой. Затем
   `git fetch --prune`; главный чекаут на `main` без незакоммиченного — fast-forward к
   `origin/main` (иначе сообщение, старт идёт дальше).
2. PR автора (`gh pr list --author @me`) на ветках сессий (`ticket-N`, `ticket-N-*`; ручные PR
   владельца на других ветках не трогаются), кроме черновиков: красный CI на head (провал
   `restricted-paths` не в счёт — это ожидание владельца) или нет отметки ревью (статус `review`)
   на head; отметка с выключенным авто-мёржем — не обрыв (`ship-finish` ставит отметку последней),
   так владелец придерживает PR. PR, в worktree которого идёт сессия (замок `session-run`), не
   берётся. Есть такие — берётся первый (красные раньше), тикет
   откладывается. Красный CI — возврат: комментарий «возврат k/2 … на <sha>»; на тот же head
   второй раз не пишется. Третий
   возврат не делается: метка `ready-for-human` и комментарий-форма (вопрос, логи, варианты,
   рекомендация), PR пропускается, пока метка стоит. Владелец снял метку — ответ дан: счёт
   возвратов начинается заново. PR без отметки — дозапуск `/ship`, возвратом не считается.
3. Тикет: открыт, не назначен другому. Сессия тикета уже идёт (замок `session-run` в его
   worktree) — стоп.
4. Worktree и ветка: уже есть worktree на ветке — он; иначе рядом с главным
   `../<проект>-ticket-N` (`../<проект>-pr-M`) на ветке `ticket-N` от `origin/main` (на ветке PR).
   Ветка тикета `ticket-N` или `ticket-N-*` уже есть локально или на сервере — берётся она (две
   с суффиксом — стоп, выбрать вручную). Ветка тикета, уже слитая squash-мёржем (её конец — head
   слитого PR или его предок, и его нет в `origin/main`), заново не берётся, иначе её коммиты
   уйдут в новый PR: только локальная и без worktree — удаляется, новая идёт от `origin/main`;
   на сервере или с worktree — стоп с командой, как убрать. Новые коммиты поверх слитого head —
   обычная работа ветки (новый PR), их старт не трогает. Ветка PR подтягивается к серверу
   fast-forward; разошлась — стоп; на сервере её нет — сбой git. Потом проектная
   `scripts/session/setup` в корне worktree, если есть.
   Перед worktree — уборка слитых PR (только если старт дошёл сюда): ветка `ticket-*`, которой
   нет на сервере и чей конец — head слитого PR или его предок (любым мёржем, и squash; head,
   которого нет локально, подтягивается `pull/<N>/head`), — её
   worktree (`git worktree remove` без `--force`: незакоммиченное, кроме игнорируемого, держит
   его; занятый, с живой сессией или каталог самого старта — пропуск с сообщением), проектная
   `cleanup` для него и ветка. С новыми коммитами поверх слитого head, сбой git или `gh` на
   ветке — пропуск с сообщением. Ветка этого старта и главный чекаут не
   трогаются.
5. Метка `in-progress` и исполнитель — я: после worktree и `setup`, чтобы сбой на них не оставил
   тикет занятым без сессии.

Итог — путь worktree, метка сессии `CANON_SESSION` (её читает Stop-хук), промпт и строка
«Запуск:» для новой сессии из терминала. Не из `session-run` и не изнутри worktree плана — ещё
строка «Открытая сессия остаётся в главном чекауте»: команды с путём worktree, `EnterWorktree` не
вызывать (вход вне `.claude/worktrees/` ждёт клика владельца). С `--json` — последней строкой
JSON. Код выхода 0 — готово; 1 — сбой git, `gh` или `scripts/session/setup`; 2 — ошибка
аргументов, тикет закрыт или занят другим, сессия тикета уже идёт, неоднозначная или уже слитая
ветка тикета (сообщение говорит, что убрать).

`session-run` вызывает `prepare` этого файла в своём процессе и через `claim` берёт замок сессии
под блокировкой реестра — параллельный старт не увидит worktree свободным в промежутке.

Файл вендорится из канона `alexkabchina-arch/workflow`: руками не править.
Только стандартная библиотека Python 3.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

REGISTRY = "canon-sessions.json"
SETUP = "scripts/session/setup"
CLEANUP = "scripts/session/cleanup"
REVIEW = "review"
WAITING = "ready-for-human"
IN_PROGRESS = "in-progress"
OWNER_CHECKS = {"restricted-paths"}
RED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}
MAX_RETURNS = 2
# Замок сессии в личном каталоге git worktree: `session-run` держит его, пока идёт `claude`.
SESSION_LOCK = "canon-session.lock"
SESSION_BRANCH = re.compile(r"^ticket-\d+(-.+)?$")
RETURN_RE = re.compile(r"^возврат (\d+)/\d+: красный CI на ([0-9a-f]{7})")
FORM_MARK = f"{WAITING}: третий возврат не делается"
PR_FIELDS = "number,title,url,headRefName,headRefOid,isDraft,labels,statusCheckRollup"
PR_LIMIT = "200"


class StartError(Exception):
    """Сбой git, gh или проектной команды (код выхода 1)."""


class UsageError(Exception):
    """Ошибка аргументов или состояния тикета (код выхода 2)."""


def run(*cmd: str, cwd: Path | None = None) -> str:
    result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise StartError(f"{' '.join(cmd[:3])}: {(result.stderr or result.stdout).strip()}")
    return result.stdout.strip()


def project_command(cmd: list[str], cwd: Path) -> tuple[int, str]:
    """Проектный скрипт: (код, вывод); не запустился (нет +x, shebang) — код -1."""
    try:
        result = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)
    except OSError as exc:
        return -1, f"не запускается: {exc}"
    return result.returncode, (result.stderr or result.stdout).strip()


def note(text: str) -> None:
    print(f"session-start: {text}", file=sys.stderr)


# --- git ---


def worktrees() -> list[dict]:
    """`git worktree list --porcelain`: [{path, branch}], первый — главный."""
    found, current = [], {}
    for line in run("git", "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if current:
                found.append(current)
            current = {}
        elif line.startswith("worktree "):
            current["path"] = str(Path(line[len("worktree ") :]).resolve())
        elif line.startswith("branch refs/heads/"):
            current["branch"] = line[len("branch refs/heads/") :]
    return found


def tip(ref: str) -> str | None:
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", ref], capture_output=True, text=True
    )
    return result.stdout.strip() if result.returncode == 0 else None


def has_ref(ref: str) -> bool:
    return tip(ref) is not None


def git_ok(*args: str, cwd: Path) -> bool:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=False).returncode == 0


def is_ancestor(older: str, newer: str, cwd: Path) -> bool:
    """Код 1 — не предок; любой другой ненулевой (нет ссылки, сбой git) — `StartError`."""
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", older, newer],
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    if result.returncode not in (0, 1):
        raise StartError(f"git merge-base --is-ancestor {older} {newer}: {result.stderr.strip()}")
    return result.returncode == 0


def worktree_of(branch: str) -> Path | None:
    return next((Path(w["path"]) for w in worktrees() if w.get("branch") == branch), None)


# --- замок сессии ---


def take_lock(worktree: Path):
    """Замок сессии worktree — открытый файл под flock; None — его держит другой процесс.

    Файл — в личном каталоге git worktree. `session-run` держит замок, пока идёт `claude`;
    снимается с концом процесса, в том числе аварийным.
    """
    git_dir = run("git", "-C", str(worktree), "rev-parse", "--path-format=absolute", "--git-dir")
    lock = open(Path(git_dir) / SESSION_LOCK, "a")  # noqa: SIM115 — держит вызывающий
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return None
    return lock


def session_busy(branch: str) -> Path | None:
    """Worktree ветки, где сейчас идёт сессия; иначе None. Только под блокировкой реестра.

    Кандидаты — worktree на ветке и записи реестра с этой веткой: живая сессия могла уйти с ветки
    (rebase, detached HEAD).
    """
    alive = {w["path"]: w.get("branch") for w in worktrees()}
    paths = {path for path, name in alive.items() if name == branch}
    paths |= {
        path
        for path, entry in read_registry().items()
        if entry.get("branch") == branch and path in alive
    }
    for path in sorted(paths):
        lock = take_lock(Path(path))
        if lock is None:
            return Path(path)
        lock.close()
    return None


# --- реестр и уборка ---


def common_dir() -> Path:
    return Path(run("git", "rev-parse", "--path-format=absolute", "--git-common-dir"))


@contextlib.contextmanager
def registry_lock():
    """Параллельные старты правят реестр по очереди."""
    with open(common_dir() / (REGISTRY + ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def read_registry() -> dict:
    path = common_dir() / REGISTRY
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}


def write_registry(entries: dict) -> None:
    path = common_dir() / REGISTRY
    text = json.dumps(entries, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8") as tmp:
        tmp.write(text)
    os.replace(tmp.name, path)


def clean_resources(path: str, main: Path) -> bool:
    """Проектная `cleanup <путь>` из главного worktree; нет команды — убирать нечего."""
    command = main / CLEANUP
    if not command.is_file():
        return True
    code, output = project_command([str(command), path], main)
    if code != 0:
        note(f"уборка {path} не удалась ({CLEANUP}): {output}; повтор при следующем старте")
        return False
    note(f"убраны ресурсы worktree {path}")
    return True


def cleanup(main: Path) -> set[str]:
    """Уборка исчезнувших worktree; итог — пути, чьи ресурсы убрать не удалось."""
    run("git", "worktree", "prune")
    alive = {w["path"] for w in worktrees()}
    entries = read_registry()
    pending = set()
    for path in sorted(set(entries) - alive):
        if not clean_resources(path, main):
            pending.add(path)
            continue
        del entries[path]
    write_registry(entries)
    return pending


def sync_main(main: Path) -> None:
    """Главный чекаут на `main` без правок — fast-forward к `origin/main`; иначе сообщение.

    Отставший `main` подсовывает `/code-review` старую базу. Старт это не останавливает.
    """
    branch = subprocess.run(
        ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
        cwd=main,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if branch != "main":
        note(f"главный чекаут {main} не на main ({branch or 'detached HEAD'}) — не догнан")
        return
    try:
        dirty = run("git", "status", "--porcelain", "--untracked-files=no", cwd=main)
    except StartError as exc:
        note(f"главный чекаут {main} не догнан до origin/main: {exc}")
        return
    if dirty:
        note(f"главный чекаут {main}: незакоммиченные правки — не догнан до origin/main")
        return
    try:
        run("git", "merge", "-q", "--ff-only", "origin/main", cwd=main)
    except StartError as exc:
        note(
            f"главный чекаут {main} не догнан до origin/main (разошёлся или мешают "
            f"неотслеживаемые файлы): {exc}"
        )


def sweep_merged(main: Path, keep: str, here: Path | None) -> set[str]:
    """Worktree и ветки слитых PR; итог — пути, чьи ресурсы убрать не удалось.

    Убирается ветка `ticket-*`, которой нет на сервере и чей конец — head слитого PR или его
    предок, каким бы мёржем PR ни был слит (`ship-finish` сливает squash): её worktree
    (`git worktree remove` без `--force`), проектная `cleanup` для него, затем ветка. С новыми
    коммитами поверх слитого head — пропуск с сообщением. Не трогаются: `keep` (ветка этого
    старта), ветки на сервере (открытые PR), главный чекаут, ветка с живой сессией, worktree, из
    которого запущен старт (`here`: открытая сессия без замка). Сбой git или `gh` на ветке —
    пропуск, старт идёт дальше.
    """
    branches = run("git", "for-each-ref", "--format=%(refname:short)", "refs/heads/ticket-*")
    holders = {w.get("branch"): Path(w["path"]) for w in worktrees()}
    pending = set()
    for branch in branches.split():
        if branch == keep or not SESSION_BRANCH.match(branch):
            continue
        try:
            if path := sweep_branch(branch, holders.get(branch), main, here):
                pending.add(path)
        except StartError as exc:
            note(f"пропуск {branch}: {exc}")
    return pending


def merged_url(end: str, merged: dict[str, dict], main: Path) -> str | None:
    """PR, слитый с концом `end` или с коммитами поверх него (ветку догнали на сервере).

    head такого PR после squash-мёржа локально обычно нет: он подтягивается с сервера
    (`pull/<N>/head`, как в `ship-finish`); не подтянулся — не этот PR.
    """
    if end in merged:
        return merged[end]["url"]
    for head, pr in merged.items():
        fetch_head(head, pr["number"], main)
        with contextlib.suppress(StartError):  # head нет локально — не этот PR
            if is_ancestor(end, head, main):
                return pr["url"]
    return None


def fetch_head(sha: str, number: int, main: Path) -> None:
    """head слитого PR — локально; нет — `git fetch origin pull/<N>/head`, сбой не страшен."""
    if git_ok("cat-file", "-e", f"{sha}^{{commit}}", cwd=main):
        return
    git_ok("fetch", "-q", "origin", f"pull/{number}/head", cwd=main)


def sweep_branch(branch: str, path: Path | None, main: Path, here: Path | None) -> str | None:
    """Одна ветка `sweep_merged`; итог — путь worktree, чьи ресурсы убрать не удалось."""
    if has_ref(f"refs/remotes/origin/{branch}"):
        return None
    end = tip(f"refs/heads/{branch}")
    if end is None:  # ветку уже удалили
        return None
    merged = merged_heads(branch)
    url = merged_url(end, merged, main)
    if url is None:
        if merged:
            note(
                f"пропуск {branch}: конец ветки — не head слитого PR и не его предок "
                "(новые коммиты поверх слитого или head слитого PR не получен с сервера)"
            )
        return None
    if path == main:
        note(f"пропуск {branch}: на ней главный чекаут")
        return None
    # По реестру тоже: живая сессия могла уйти с ветки в detached HEAD.
    if busy := session_busy(branch):
        note(f"пропуск {branch}: в {busy} идёт сессия")
        return None
    if path is not None and here is not None and here.is_relative_to(path):
        note(f"пропуск {branch}: из {path} запущен этот старт")
        return None
    failed = None
    if path is not None:
        result = subprocess.run(
            ["git", "worktree", "remove", str(path)], capture_output=True, text=True
        )
        if result.returncode != 0:
            note(f"пропуск {branch}: {path} не убран — {result.stderr.strip()}")
            return None
        note(f"убран worktree {path} слитого PR {url}")
        entries = read_registry()
        if clean_resources(str(path), main):
            entries.pop(str(path), None)
        else:
            entries.setdefault(str(path), {"branch": branch})
            failed = str(path)
        write_registry(entries)
    # Конец ветки — head слитого PR или его предок (проверено выше): работы сверх слитой нет.
    # `-d` отказал бы на squash-мёрже (ветки нет в `origin/main`) и сверял бы её с HEAD главного
    # чекаута, который мог не догнаться. `-D`, а не `update-ref -d`: он убирает и настройки ветки в
    # конфиге и не трогает ветку, которую перебазируют в другом worktree.
    if tip(f"refs/heads/{branch}") != end:
        note(f"пропуск {branch}: ветку сдвинули во время уборки")
        return failed
    run("git", "branch", "-q", "-D", branch)
    note(f"удалена ветка {branch} слитого PR {url}")
    return failed


# --- PR автора ---


def is_red(item: dict) -> bool:
    name = item.get("name") or item.get("context")
    state = item.get("conclusion") or item.get("state")
    return name not in OWNER_CHECKS and state in RED


def failed_checks(pr: dict) -> list[str]:
    return [
        f"{item.get('name') or item.get('context')}="
        f"{item.get('conclusion') or item.get('state')}"
        + (f" ({url})" if (url := item.get("detailsUrl") or item.get("targetUrl")) else "")
        for item in pr.get("statusCheckRollup") or []
        if is_red(item)
    ]


def is_marked(pr: dict) -> bool:
    return any(
        item.get("context") == REVIEW and item.get("state") == "SUCCESS"
        for item in pr.get("statusCheckRollup") or []
    )


def attention() -> list[tuple[dict, bool]]:
    """PR сессий автора, требующие внимания: [(pr, красный)], красные первыми, по номеру."""
    prs = json.loads(
        run(
            "gh",
            "pr",
            "list",
            "--author",
            "@me",
            "--state",
            "open",
            "--limit",
            PR_LIMIT,
            "--json",
            PR_FIELDS,
        )
    )
    found = []
    for pr in prs:
        if pr.get("isDraft") or not SESSION_BRANCH.match(pr["headRefName"]):
            continue
        red = bool(failed_checks(pr))
        if red or not is_marked(pr):
            found.append((pr, red))
    return sorted(found, key=lambda item: (not item[1], item[0]["number"]))


def since_last_form(pr: dict) -> tuple[bool, list[str]]:
    """(форма уже была, комментарии после последней формы)."""
    comments = json.loads(run("gh", "pr", "view", str(pr["number"]), "--json", "comments"))
    bodies = [c["body"] for c in comments["comments"]]
    forms = [i for i, body in enumerate(bodies) if body.startswith(FORM_MARK)]
    return bool(forms), bodies[forms[-1] + 1 :] if forms else bodies


def waits_owner(pr: dict, had_form: bool, recent: list[str]) -> bool:
    """Метка стоит и после формы возвратов не было — PR ждёт ответа владельца.

    Метка без формы (перерасход ревью у `ship-finish`, сбой между меткой и формой) — не ожидание.
    """
    labeled = any(lb["name"] == WAITING for lb in pr.get("labels") or [])
    return labeled and had_form and not any(RETURN_RE.match(b) for b in recent)


def count_return(pr: dict, recent: list[str]) -> int | None:
    """Номер возврата для красного head; None — возвраты исчерпаны, PR ушёл владельцу."""
    number, sha = str(pr["number"]), pr["headRefOid"][:7]
    seen = {}
    for body in recent:
        if m := RETURN_RE.match(body):
            seen[m.group(2)] = int(m.group(1))
    if sha in seen:
        return seen[sha]
    k = max(seen.values(), default=0) + 1
    checks = failed_checks(pr)
    if k > MAX_RETURNS:
        run("gh", "pr", "edit", number, "--add-label", WAITING)
        run("gh", "pr", "comment", number, "--body", human_form(pr, checks))
        note(f"PR #{number}: возвраты исчерпаны — {WAITING}, сессия не запускается")
        return None
    body = f"возврат {k}/{MAX_RETURNS}: красный CI на {sha} — {', '.join(checks)}. "
    body += "Сессия автора берёт PR в работу (session-start)."
    run("gh", "pr", "comment", number, "--body", body)
    return k


def human_form(pr: dict, checks: list[str]) -> str:
    lines = [
        f"{FORM_MARK} — CI снова красный на {pr['headRefOid'][:7]} после {MAX_RETURNS} возвратов.",
        "",
        "**Вопрос:** как довести PR, если две сессии подряд не сделали CI зелёным?",
        "",
        "**Упавшие проверки (логи):**",
        *(f"- {c}" for c in checks),
        "",
        "**Варианты:**",
        "1. Разобрать причину и ответить комментарием здесь (гипотеза, куда смотреть), "
        f"затем снять `{WAITING}` — следующий старт сессии возьмёт PR с ответом, "
        "счёт возвратов начнётся заново.",
        "2. Закрыть PR и переписать тикет: задача поставлена неверно или слишком велика.",
        "3. Довести PR руками.",
        "",
        "**Сделано по умолчанию:** PR оставлен как есть, новая сессия на него не запущена; "
        "стартовая команда пропускает PR, пока стоит метка.",
        "",
        "**Рекомендация:** вариант 1 — две неудачи подряд обычно означают, что сессии не хватает "
        "знания о проекте или окружении, а не усилий; новая попытка без ответа повторит сбой.",
    ]
    return "\n".join(lines)


def pick_pr() -> dict | None:
    for pr, red in attention():
        if busy := session_busy(pr["headRefName"]):
            note(f"PR #{pr['number']}: в {busy} уже идёт сессия — пропущен")
            continue
        had_form, recent = since_last_form(pr)
        if waits_owner(pr, had_form, recent):
            continue
        k = count_return(pr, recent) if red else 0
        if k is None:
            continue
        sha, branch = pr["headRefOid"][:7], pr["headRefName"]
        answered = (
            " Владелец ответил в PR после третьей неудачи — прочитай ответ." if had_form else ""
        )
        if red:
            prompt = (
                f"PR #{pr['number']} (ветка {branch}): красный CI на {sha} — "
                f"{', '.join(failed_checks(pr))}; возврат {k}/{MAX_RETURNS}.{answered} "
                "Найди причину, исправь в этой ветке, затем /ship."
            )
        else:
            prompt = (
                f"PR #{pr['number']} (ветка {branch}): нет отметки review на {sha} — сессия "
                f"оборвалась до конца /ship.{answered} Доведи /ship."
            )
        return {
            "kind": "pr",
            "pr": pr["number"],
            "url": pr["url"],
            "branch": branch,
            "session": f"pr-{pr['number']}",
            "prompt": prompt,
        }
    return None


# --- тикет ---


def check_ticket(number: int) -> bool:
    """Тикет можно брать; True — метку `in-progress` и исполнителя ещё ставить."""
    fields = "number,state,labels,assignees"
    issue = json.loads(run("gh", "issue", "view", str(number), "--json", fields))
    if issue["state"] != "OPEN":
        raise UsageError(f"тикет #{number} закрыт")
    me = run("gh", "api", "user", "--jq", ".login")
    labels = {lb["name"] for lb in issue.get("labels") or []}
    assignees = {a["login"] for a in issue.get("assignees") or []}
    if assignees and me not in assignees:
        raise UsageError(f"тикет #{number} уже в работе: {', '.join(sorted(assignees))}")
    return IN_PROGRESS not in labels or me not in assignees


def mark_ticket(number: int) -> None:
    """Метка и исполнитель — после повторной проверки: за время `setup` тикет мог занять другой."""
    if check_ticket(number):
        run("gh", "issue", "edit", str(number), "--add-label", IN_PROGRESS, "--add-assignee", "@me")


# --- worktree ---


def ticket_branch(number: int) -> str:
    """Ветка тикета: `ticket-N`, иначе единственная `ticket-N-*` локально или на сервере."""
    exact = f"ticket-{number}"
    names = {w.get("branch") for w in worktrees()}
    names |= set(run("git", "for-each-ref", "--format=%(refname:short)", "refs/heads/").split())
    remote = run("git", "for-each-ref", "--format=%(refname:short)", "refs/remotes/origin/")
    names |= {r[len("origin/") :] for r in remote.split()}
    if exact in names:
        return exact
    suffixed = sorted(n for n in names if n and n.startswith(exact + "-"))
    if len(suffixed) > 1:
        raise UsageError(
            f"у тикета #{number} несколько веток: {', '.join(suffixed)}; "
            "лишние удалите или переименуйте"
        )
    return suffixed[0] if suffixed else exact


def merged_heads(branch: str) -> dict[str, dict]:
    """Слитые в main PR ветки: {head: {"url", "number"}}.

    PR, слитый в другую ветку (стек PR), работу в main не донёс — для уборки ветка не слита.
    """
    query = ["--head", branch, "--base", "main", "--state", "merged"]
    found = run("gh", "pr", "list", *query, "--json", "number,url,headRefOid")
    return {pr["headRefOid"]: pr for pr in json.loads(found)}


def retire_spent(branch: str, main: Path) -> None:
    """Ветка тикета, уже слитая squash-мёржем, заново не берётся: её коммиты ушли бы в новый PR.

    Слитая — её конец равен head слитого PR или его предок (ветку догнали на сервере; head
    подтягивается, как в `merged_url`), и его нет в `origin/main` (при мёрже обычным merge commit
    он там есть, и ветка годна как есть). Только локальная и без worktree —
    удаляется (работы сверх слитой нет), дальше ветка заводится от `origin/main`; иначе — стоп.
    """
    local, remote = tip(f"refs/heads/{branch}"), tip(f"refs/remotes/origin/{branch}")
    if local is None and remote is None:
        return
    merged = merged_heads(branch)
    spent = {
        end: url
        for end in {local, remote} - {None}
        if (url := merged_url(end, merged, main)) and not is_ancestor(end, "origin/main", main)
    }
    if remote in spent and local in (None, remote):
        raise UsageError(
            f"ветка {branch} уже слита ({spent[remote]}) и осталась на сервере: удалите её "
            f"(`git push origin --delete {branch}`) и повторите старт"
        )
    if local in spent and remote is None:
        if holder := worktree_of(branch):
            fix = (
                f"переключите его на main (`git -C {holder} switch main`)"
                if holder == main
                else f"уберите его (`git worktree remove {holder}`)"
            )
            raise UsageError(
                f"ветка {branch} уже слита ({spent[local]}), на ней worktree {holder}: {fix} "
                "и повторите старт"
            )
        run("git", "branch", "-q", "-D", branch)
        note(f"ветка {branch} уже слита ({spent[local]}) — удалена, новая от origin/main")


def ensure_worktree(main: Path, branch: str, name: str, pending: set[str]) -> Path:
    """Worktree на ветке: существующий, иначе новый `../<проект>-<name>`."""
    if existing := worktree_of(branch):
        return existing
    path = (main.parent / f"{main.name}-{name}").resolve()
    if str(path) in pending:
        raise StartError(
            f"ресурсы прежнего worktree {path} не убраны ({CLEANUP}): "
            "сначала уборка, иначе новая сессия унаследует старые"
        )
    if has_ref(f"refs/heads/{branch}"):
        run("git", "worktree", "add", "-q", str(path), branch)
    elif has_ref(f"refs/remotes/origin/{branch}"):
        run("git", "worktree", "add", "-q", "-b", branch, str(path), f"origin/{branch}")
    else:
        run("git", "worktree", "add", "-q", "--no-track", "-b", branch, str(path), "origin/main")
    return path


def sync_pr_branch(worktree: Path, branch: str) -> None:
    """Ветка PR — не старее сервера: fast-forward; разошлась — стоп."""
    remote = f"origin/{branch}"
    if is_ancestor(remote, "HEAD", worktree):
        return
    if not is_ancestor("HEAD", remote, worktree):
        raise StartError(f"ветка {branch} в {worktree} разошлась с {remote}: свести вручную")
    run("git", "merge", "-q", "--ff-only", remote, cwd=worktree)


def setup(worktree: Path) -> None:
    command = worktree / SETUP
    if not command.is_file():
        return
    code, output = project_command([str(command)], worktree)
    if code != 0:
        raise StartError(f"{SETUP} в {worktree}: код {code}: {output}")


# --- сборка ---


def start(number: int, claim=None, here: Path | None = None) -> dict:
    """Готовит сессию; `claim(worktree)` — под блокировкой реестра, до `setup` (замок сессии).

    `here` — каталог, откуда запущен старт: его worktree уборка слитых PR не трогает.
    """
    main = Path(worktrees()[0]["path"])
    os.chdir(main)
    with registry_lock():
        pending = cleanup(main)
        # --prune: ветка, удалённая на сервере после мёржа, не должна браться из старой ссылки.
        run("git", "fetch", "-q", "--prune", "origin")
        sync_main(main)
        plan = pick_pr()
        if plan is None:
            unmarked = check_ticket(number)
            branch = ticket_branch(number)
            if busy := session_busy(branch):
                raise UsageError(f"сессия тикета #{number} уже идёт в {busy}")
            retire_spent(branch, main)
            pending |= sweep_merged(main, keep=branch, here=here)
            plan = {
                "kind": "ticket",
                "ticket": number,
                "branch": branch,
                "session": f"ticket-{number}",
                "prompt": f"/implement #{number}, затем /ship",
            }
            worktree = ensure_worktree(main, branch, plan["session"], pending)
        else:
            plan["postponed"] = number
            pending |= sweep_merged(main, keep=plan["branch"], here=here)
            worktree = ensure_worktree(main, plan["branch"], plan["session"], pending)
            sync_pr_branch(worktree, plan["branch"])
        plan["branch"] = run("git", "-C", str(worktree), "symbolic-ref", "--short", "HEAD")
        plan["worktree"] = str(worktree)
        if claim is not None:
            claim(worktree)
        entries = read_registry()
        entries[str(worktree)] = {"session": plan["session"], "branch": plan["branch"]}
        write_registry(entries)
    setup(worktree)
    if plan["kind"] == "ticket" and unmarked:
        mark_ticket(number)
    return plan


def report(plan: dict, outside: bool) -> str:
    """Итог для человека; `outside` — старт не из `session-run` и не изнутри worktree плана:
    из открытой сессии в главном чекауте или из терминала — их скрипт не различает."""
    if plan["kind"] == "pr":
        head = f"PR автора требует внимания: {plan['url']} — тикет #{plan['postponed']} отложен"
    else:
        head = f"тикет #{plan['ticket']}: метка {IN_PROGRESS}"
    lines = [
        f"session-start: {head}",
        f"  worktree  {plan['worktree']} (ветка {plan['branch']})",
        f"  сессия    CANON_SESSION={plan['session']}",
        f"  промпт    {plan['prompt']}",
        f"Запуск: cd {shlex.quote(plan['worktree'])} && CANON_SESSION={plan['session']} "
        f"claude -- {shlex.quote(plan['prompt'])}",
    ]
    if outside:
        wt = shlex.quote(plan["worktree"])
        lines.append(
            f"Открытая сессия остаётся в главном чекауте: команды — `cd {wt} && …` или "
            f"`git -C {wt}`, правки — по абсолютным путям в worktree; EnterWorktree не вызывать "
            "(вход вне .claude/worktrees/ ждёт клика владельца); промпт набирает владелец, "
            "«Запуск:» — для новой сессии из терминала"
        )
    return "\n".join(lines)


def prepare(ticket: str, claim=None) -> tuple[int, dict | None]:
    """Старт с печатью итога: (код выхода, план); план — только при коде 0."""
    try:
        try:
            here = Path.cwd().resolve()  # `start` уходит в главный worktree
        except FileNotFoundError:
            raise UsageError(
                "текущий каталог удалён (терминал остался в убранном worktree) — перейдите в "
                "главный чекаут проекта и повторите старт"
            ) from None
        if not ticket.lstrip("#").isdigit():
            raise UsageError(f"номер тикета — число, а не {ticket!r}")
        plan = start(int(ticket.lstrip("#")), claim, here)
    except UsageError as exc:
        note(str(exc))
        return 2, None
    except StartError as exc:
        note(str(exc))
        return 1, None
    inside = here.is_relative_to(Path(plan["worktree"]).resolve())
    print(report(plan, outside=claim is None and not inside))
    return 0, plan


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="session-start", description=__doc__.split("\n\n")[0])
    parser.add_argument("ticket", help="номер тикета")
    parser.add_argument("--json", action="store_true", help="итог последней строкой JSON")
    args = parser.parse_args(argv)
    code, plan = prepare(args.ticket)
    if plan is not None and args.json:
        print(json.dumps(plan, ensure_ascii=False))
    return code


if __name__ == "__main__":
    sys.exit(main())
