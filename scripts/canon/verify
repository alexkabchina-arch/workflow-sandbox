#!/usr/bin/env python3
"""verify — проверка изменения ветки встроенным `/verify` (шаг 4 `/ship`).

    scripts/canon/verify <отчёт.json> --criteria-file <файл> \\
        [--base origin/main] [--max-budget-usd 10]

Из корня проекта, на закоммиченной ветке. Встроенный `/verify` из сессии не вызвать — только
дочерним процессом, поэтому скрипт запускает его обычным вызовом, не в фоне:

    claude -p --model claude-opus-5-5 --max-budget-usd <предел> --output-format json \\
        --json-schema <схема итога> --disallowedTools=Agent,Workflow,Monitor \\
        --permission-mode auto \\
        "/verify Проверь изменение ветки: дифф git diff <база>...HEAD. …"

Диапазон диффа — всегда явный: без него скилл берёт `@{u}..` или `origin/HEAD...` и на ветке без
upstream проверит не тот код. Критерии тикета — из `--criteria-file` как есть: в задание они
попадают аргументом, без оболочки, поэтому обратные кавычки и `$` в них безопасны.

Итог — структурированным ответом по схеме (`--json-schema`), а не строкой в тексте, которую
пришлось бы угадывать: поле `verdict` и поле `report` (что проверено). `verdict` — PASS или FAIL,
когда проверка состоялась, и BLOCKED, когда проверить не удалось (нет рецепта, нужен ответ
человека). В `<отчёт.json>` — сырой результат (`modelUsage`, стоимость, `structured_output`), рядом
`<отчёт>.md` — `report` и строка итога (его читает сессия). BLOCKED, ответ не по схеме или его нет —
проверка не состоялась, `.md` нет, а ответ — в `<отчёт>.raw.md` для разбора. Готовый отчёт прошлого
прогона переносится в `<отчёт>.prev.md` и `.prev.json`.

До запуска: нет своего `verify`, который подменил бы встроенный, — в `.claude/` проекта и в личном
слое (`$CLAUDE_CONFIG_DIR` или `~/.claude`): скилла `skills/verify/` или с `name: verify`, команды
`commands/**/verify.md`; нет незакоммиченных правок отслеживаемых файлов (проверка шла бы не по коду
ветки). Пустой дифф (ветка без своих коммитов) — проверка пропускается, как у `review`. После
прогона, в том числе неудачного, — что `/verify` оставил: новые файлы рабочего дерева (рецепт
`.claude/skills/run-*`, свой `.claude/skills/verify/`, тестовые файлы), свои коммиты, смену ветки
или переписанную историю — разбирает сессия. Дороже предела — строка `verify: предупреждение: …`,
вдвое и больше — ещё `verify: ready-for-human: …`, как у `review`.

Код выхода 0 — проверка состоялась (строка `verify: … PASS|FAIL`, полный итог — в `.md`) или
пропущена (`verify: пропущено`); 1 — не состоялась (сбой `claude`, выход по бюджету, ошибка,
пустой `modelUsage`, не та модель, нет ответа по схеме, BLOCKED), причина и стоимость в stderr;
2 — ошибка аргументов или git (нет базы, нет или пуст файл критериев, свой `verify`,
незакоммиченные правки).
Путь v2 (#351, `CANON_V2_TASK=1` — сессия кода пути v2, `v2/task.py`): пункты — критерии тикета с
номером и видом доказательства, примеры замысла и находки ревью со сценарием `/verify` из копии
отчёта ревью рядом с отчётом (`review.json`, номера `Н<n>`, #352) (`v2/criteria.py`; нет
критериев — код 2); число «должно быть» примера сверяет программа; модель и усилие — роль
`verify` из `v2/roles.py`; инструмент проверки и карта функций — из основы
по блоку ```verify-tool профиля, во временном каталоге (`CANON_VERIFY_TOOL`, приложение —
`CANON_VERIFY_APP`); перед моделью — «доктор» из того же блока. По каждому пункту — прошло, не
прошло или не проверить с записанными командами; итог считает программа: «не прошло» — FAIL,
иначе «не проверить» — код 1 с меткой `UNVERIFIABLE` (у оркестратора — код «среда» без
возврата), иначе PASS. Нет инструмента в основе, красный «доктор» — тоже «не проверить».
Вызывающему нужен таймаут Bash больше времени проверки (`BASH_MAX_TIMEOUT_MS` в настройках канона).
Файл вендорится из канона `alexkabchina-arch/workflow`: руками не править.
Только стандартная библиотека Python 3.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import types
from pathlib import Path


def load(name: str, rel: str):
    """Модуль канона рядом со скриптом — без правки `sys.path` и без `__pycache__`
    в вендоренном `scripts/canon/` (его закоммитили бы вместе с работой ветки)."""
    path = Path(__file__).resolve().parent / rel
    module = types.ModuleType(name)
    module.__file__ = str(path)
    exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), module.__dict__)
    return module


claude_run = load("canon_claude_run", "claude_run.py")  # общий запуск `claude -p` с `review`
v2_criteria = load("canon_v2_criteria_verify", "v2/criteria.py")  # формат и три исхода (#351)
v2_snapshot = load("canon_v2_snapshot_verify", "v2/snapshot.py")  # пункты чек-листа критериев

# Спросить по ходу некого: дочерний процесс без человека.
PERMISSION_MODE = "auto"
UsageError = claude_run.UsageError

DONE = ("PASS", "FAIL")
BLOCKED = "BLOCKED"
SCHEMA = {
    "type": "object",
    "properties": {
        "verdict": {
            "type": "string",
            "enum": [*DONE, BLOCKED],
            "description": "PASS — все критерии подтверждены живой проверкой; FAIL — проверка "
            "прошла, и критерий не подтвердился; BLOCKED — проверить не удалось (нет рецепта "
            "запуска, нужен ответ человека, окружение не поднялось)",
        },
        "report": {
            "type": "string",
            "description": "Отчёт в markdown: что проверено — шаги, пробы мимо счастливого пути, "
            "результат по каждому критерию; при FAIL — что не подтвердилось, при BLOCKED — что "
            "помешало проверить",
        },
    },
    "required": ["verdict", "report"],
    "additionalProperties": False,
}

TASK = """/verify Проверь изменение ветки: дифф git diff {base}...HEAD.
Критерии:
{criteria}
Запуск — по рецепту из раздела профиля «Рецепт запуска для /verify». Ничего не ставить; без фоновых
средств харнеса; тестовые записи откатить; приложение погасить после; не коммитить и не
переключать ветку.
Итог — структурированным ответом: verdict и report — что проверено (шаги, пробы мимо счастливого
пути, результат по каждому критерию). Спросить некого: проверить не удалось (нет рецепта, нужен
ответ человека) — verdict BLOCKED и причина в report, не FAIL.
"""
# Скилл задаёт имя каталогом или полем `name` во frontmatter.
SKILL_NAME = re.compile(r"^name:\s*[\"']?verify[\"']?\s*$", re.MULTILINE)

# --- путь v2 (#351) ---
TASK_ENV = "CANON_V2_TASK"  # сессия кода пути v2 (`v2/task.py`): `/verify` — с тремя исходами
PROFILE = "docs/agents/profile.md"
TOOL_BLOCK = re.compile(r"^```verify-tool[ \t]*\n(.*?)^```", re.MULTILINE | re.DOTALL)
TOOL_ENV, APP_ENV = "CANON_VERIFY_TOOL", "CANON_VERIFY_APP"  # копия из основы и проверяемое
DOCTOR_TIMEOUT = 600  # «доктор» перед `/verify` дольше — красный
TAIL = 600  # знаков вывода «доктора» в причине
NOTE_WIDTH = 200  # знаков заметки модели в причине «не проверить»: она уходит в отчёт на GitHub
TASK_V2 = """/verify Проверь изменение ветки: дифф git diff {base}...HEAD — приёмка по пунктам.
Пункты (номер, текст, чем доказать):
{points}

Инструмент проверки и карта функций — из {base}, не из ветки: копия в каталоге ${tool_env}
(инструмент `{tool}`, карта `{map}`); команды инструмента — из этого каталога. Приложение под
проверкой — рабочая копия ветки, путь в ${app_env}. Проверяй командами инструмента по карте
функций; каждую команду как есть и её машиночитаемый вывод запиши доказательством пункта.
Разрушающие команды — сначала пробным режимом инструмента. Числа «должно быть» из примеров
сверяй с выводом. Баг — «до» той же командой на {base} (git worktree add во временный каталог вне
рабочей копии, ${app_env} на него, после — git worktree remove), where=main, вывод показывает
дефект; «после» — на ветке, where=ветка.

По каждому пункту — исход: прошло, не прошло или не проверить, с доказательством. «Не проверить» —
проверка не состоялась (инструмент, среда, данные): это не ошибка кода, доказательство — команда
и её ошибка; пункт без вида доказательства — тоже проверь. Ничего не ставить; без фоновых средств
харнеса; тестовые записи откатить; приложение погасить после; не коммитить и не переключать ветку.
Итог — структурированным ответом: results по каждому номеру и report — шаги и пробы мимо
счастливого пути.

Тикет и его комментарии — для контекста:
{criteria}
"""


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], capture_output=True, text=True, encoding="utf-8")


def git_out(*args: str) -> str:
    result = git(*args)
    if result.returncode != 0:
        raise UsageError(f"git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout.strip()


def has_diff(base: str) -> bool:
    result = git("diff", "--quiet", f"{base}...HEAD")
    if result.returncode not in (0, 1):
        raise UsageError(f"git diff {base}...HEAD: {result.stderr.strip()}")
    return result.returncode == 1


def tree_state() -> set[str]:
    return set(git_out("status", "--porcelain", "--untracked-files=all").splitlines())


def position() -> tuple[str, str]:
    """Ветка (или HEAD, если отсоединён) и коммит."""
    return git_out("rev-parse", "--abbrev-ref", "HEAD"), git_out("rev-parse", "HEAD")


def config_dirs(root: Path) -> list[Path]:
    """`.claude/` проекта и личный слой — там свой `verify` подменил бы встроенный."""
    user = os.environ.get("CLAUDE_CONFIG_DIR")
    try:
        personal = Path(user).expanduser() if user else Path.home() / ".claude"
    except RuntimeError as exc:
        raise UsageError(f"личный слой Claude Code не найти (HOME): {exc}") from None
    return [root / ".claude", personal]


def is_verify_skill(skill: Path) -> bool:
    if skill.parent.name == "verify":
        return True
    try:
        text = skill.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return False
    parts = text.split("---", 2)
    return text.startswith("---") and len(parts) == 3 and bool(SKILL_NAME.search(parts[1]))


def own_verify(base: Path) -> list[Path]:
    skills = [p for p in sorted(base.glob("skills/*/SKILL.md")) if is_verify_skill(p)]
    commands = [p for p in sorted(base.glob("commands/**/verify.md")) if p.is_file()]
    return skills + commands


def check_tree(root: Path, state: set[str]) -> None:
    found = [str(p) for base in config_dirs(root) for p in own_verify(base)]
    if found:
        raise UsageError(
            f"есть свой verify — он подменил бы встроенный /verify: {'; '.join(found)}"
        )
    dirty = sorted(line for line in state if not line.startswith("??"))
    if dirty:
        raise UsageError(
            "незакоммиченные правки — проверка шла бы не по коду ветки: " + "; ".join(dirty)
        )


def moved(before: tuple[str, str], after: tuple[str, str]) -> list[str]:
    """Что `/verify` сделал с веткой: сменил её, переписал историю или добавил коммиты."""
    (branch, commit), (new_branch, new_commit) = before, after
    if new_branch != branch:
        return [f"ветка сменилась {branch} → {new_branch} ({new_commit[:12]})"]
    if new_commit == commit:
        return []
    if git("merge-base", "--is-ancestor", commit, new_commit).returncode == 0:
        return [f"коммиты /verify поверх ветки: {commit[:12]}..{new_commit[:12]}"]
    return [f"история ветки переписана: было {commit[:12]}, стало {new_commit[:12]}"]


def leftovers(before_state: set[str], before: tuple[str, str]) -> list[str]:
    try:
        return sorted(tree_state() - before_state) + moved(before, position())
    except UsageError as exc:
        return [f"рабочее дерево не проверено: {exc}"]


def read_criteria(path: Path) -> str:
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise UsageError(f"файл критериев {path}: {exc}") from None
    if not text.strip():
        raise UsageError(f"файл критериев {path} пуст")
    return text.strip()


def task(base: str, criteria: str) -> str:
    return TASK.format(base=base, criteria=criteria)


def verdict(data: dict, report: Path) -> str:
    """PASS или FAIL из ответа по схеме; `report` и строка итога — в `.md`.

    BLOCKED или ответ не по схеме — `ChildError`, а ответ — в `.raw.md` для разбора.
    """
    output = data["structured_output"]
    result, text = output.get("verdict"), output.get("report")
    raw = claude_run.sibling(report, ".raw.md")
    if result == BLOCKED and isinstance(text, str) and text.strip():
        claude_run.write_text(raw, text)
        first = text.strip().splitlines()[0][:300]
        raise claude_run.ChildError(f"{v2_criteria.UNVERIFIABLE}: {first}; отчёт — {raw}")
    if result not in DONE or not isinstance(text, str) or not text.strip():
        claude_run.write_text(raw, json.dumps(output, ensure_ascii=False, indent=2))
        raise claude_run.ChildError(
            "ответ /verify не по схеме (нужны verdict PASS, FAIL или BLOCKED и непустой "
            f"report) — итог не распознан; ответ — {raw}"
        )
    claude_run.write_text(report.with_suffix(".md"), f"{text.rstrip()}\n\nИтог: {result}")
    return result


def points(criteria: str, report: Path | None = None) -> list[dict]:
    """Пункты приёмки пути v2: критерии с номером и видом (без «после выката»), примеры замысла
    и находки ревью со сценарием `/verify` (`Н<номер>`, #352) — из копии отчёта ревью рядом с
    отчётом `/verify` (`review.json`, её кладёт оркестратор). Номер повторяется или критериев
    нет — `UsageError`: это постановка тикета, а не среда."""
    items = v2_snapshot.criteria(v2_criteria.without_after(criteria))
    found, errors = v2_criteria.points(items, criteria)
    if errors:
        raise UsageError(f"критерии тикета не разобраны: {'; '.join(errors)}")
    if not [p for p in found if not p["id"].startswith("П")]:
        raise UsageError(
            "в тикете нет критериев приёмки — пунктов чек-листа раздела «## Acceptance criteria»"
        )
    return found + v2_criteria.findings(review_of(report))


def review_of(report: Path | None) -> dict | None:
    """Блок `canon_review` копии отчёта ревью рядом с отчётом `/verify`; нет — None."""
    if report is None:
        return None
    try:
        data = json.loads(report.with_name("review.json").read_text(encoding="utf-8"))
        return data["canon_review"]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def blocked(report: Path, why: str) -> claude_run.ChildError:
    """Проверить не удалось — на пути v2 код «среда»: причина в `.raw.md` строкой вердикта (её
    берёт маршрут для отчёта об остановке) и ошибка с меткой `UNVERIFIABLE`."""
    raw = claude_run.sibling(report, ".raw.md")
    raw.parent.mkdir(parents=True, exist_ok=True)
    claude_run.write_text(raw, f"**Verdict:** BLOCKED. {why}")
    return claude_run.ChildError(f"{v2_criteria.UNVERIFIABLE}: {why}; отчёт — {raw}")


def tool_config(base: str, report: Path) -> dict:
    """Блок ```verify-tool профиля в основе: строки `tool <путь>`, `map <путь>` и необязательная
    `doctor <команда>`. Нет профиля, блока или пути — проверить нечем."""
    shown = git("show", f"{base}:{PROFILE}")
    found = TOOL_BLOCK.search(shown.stdout) if shown.returncode == 0 else None
    if found is None:
        raise blocked(
            report, f"инструмента проверки нет: в {PROFILE} на {base} нет блока verify-tool"
        )
    config = {}
    for line in found.group(1).splitlines():
        key, _, value = line.strip().partition(" ")
        if key:
            config[key] = value.strip()
    missing = [k for k in ("tool", "map") if not config.get(k)]
    if missing:
        raise blocked(report, f"в блоке verify-tool профиля {base} нет строк: {', '.join(missing)}")
    return config


def copy_tool(base: str, config: dict, into: Path, report: Path) -> None:
    """Инструмент и карта — файлами из основы в `into` по их путям: ветка их не подменит."""
    for key in ("tool", "map"):
        listed = subprocess.run(
            ["git", "ls-tree", "-r", "-z", "--full-tree", base, "--", config[key]],
            capture_output=True,
        )
        entries = [e for e in listed.stdout.split(b"\0") if e]
        if listed.returncode != 0 or not entries:
            raise blocked(report, f"{key} `{config[key]}` нет на {base}")
        for entry in entries:
            meta, _, name = entry.partition(b"\t")
            mode, kind, sha = meta.split()
            if kind != b"blob":
                continue
            blob = subprocess.run(["git", "cat-file", "blob", sha.decode()], capture_output=True)
            if blob.returncode != 0:
                raise blocked(report, f"{key}: `{name.decode()}` не прочитан из {base}")
            target = into / name.decode("utf-8")
            target.parent.mkdir(parents=True, exist_ok=True)
            if mode == b"120000":  # символьная ссылка — ссылкой, а не файлом с её путём
                target.symlink_to(blob.stdout.decode("utf-8"))
                continue
            target.write_bytes(blob.stdout)
            if mode == b"100755":
                target.chmod(0o755)


def run_doctor(config: dict, env: dict, into: Path, report: Path) -> None:
    """«Доктор» перед `/verify`: команда проекта из основы в каталоге копии; код 0 — здоров."""
    command = config.get("doctor")
    if not command:
        return
    try:
        res = subprocess.run(
            ["sh", "-c", command],
            cwd=into,
            env=claude_run.child_env(env),  # без меток сессии и признака пути v2
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=DOCTOR_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        raise blocked(report, f"«доктор» перед /verify не кончился за {DOCTOR_TIMEOUT} с") from None
    if res.returncode != 0:
        text = res.stderr.strip() or res.stdout.strip()
        out = text.splitlines()[-1].strip()[-TAIL:] if text else "вывода нет"  # строка ошибки
        raise blocked(report, f"«доктор» перед /verify красный — код {res.returncode}: {out}")


def verdict_v2(listed: list[dict], data: dict, report: Path) -> str:
    """PASS или FAIL пути v2 — итог считает программа по исходам пунктов (`v2/criteria.py`);
    «не проверить» без «не прошло» — `blocked` с `POINTS`; ответ не по схеме — `ChildError`."""
    output = data["structured_output"]
    result, rows, errors = v2_criteria.judge(listed, output)
    if errors:
        raw = claude_run.sibling(report, ".raw.md")
        claude_run.write_text(raw, json.dumps(output, ensure_ascii=False, indent=2))
        raise claude_run.ChildError(
            f"ответ /verify не по схеме ({'; '.join(errors)}) — итог не распознан; ответ — {raw}"
        )
    text = v2_criteria.render(listed, rows, result, str(output.get("report") or ""))
    if result == "BLOCKED":
        left = [r for r in rows if r["outcome"] == v2_criteria.UNVERIFIABLE_OUTCOME]
        note = " ".join(left[0]["note"].split())[:NOTE_WIDTH]
        ids = ", ".join(r["id"] for r in left)
        exc = blocked(report, f"{v2_criteria.POINTS} {ids}: {note}")
        raw = claude_run.sibling(report, ".raw.md")
        claude_run.write_text(raw, f"{raw.read_text(encoding='utf-8').rstrip()}\n\n{text}")
        raise exc
    claude_run.write_text(report.with_suffix(".md"), text)
    return result


def run_v2(args, criteria: str, listed: list[dict], root: Path) -> tuple[dict, str]:
    """`/verify` пути v2 по пунктам `listed`: роль `verify` из таблицы, инструмент и карта из
    основы во временном каталоге, «доктор», задание по пунктам и итог программой."""
    claude_run.set_aside(args.report)  # прошлый итог не остаётся, если до `claude` не дойдёт
    os.environ[claude_run.roles.V2_ENV] = "1"  # модель и усилие — роль `verify` (`v2/roles.py`)
    config = tool_config(args.base, args.report)
    with tempfile.TemporaryDirectory(prefix="canon-verify-") as tmp:
        into = Path(tmp)
        copy_tool(args.base, config, into, args.report)
        env = {TOOL_ENV: str(into), APP_ENV: str(root)}
        run_doctor(config, env, into, args.report)
        text = TASK_V2.format(
            base=args.base,
            points=v2_criteria.listing(listed),
            tool=config["tool"],
            map=config["map"],
            tool_env=TOOL_ENV,
            app_env=APP_ENV,
            criteria=criteria,
        )
        data = claude_run.run_claude(
            ["--permission-mode", PERMISSION_MODE, text],
            args.report,
            args.max_budget_usd,
            v2_criteria.schema(listed),
            env=env,
        )
        # Пункты прогона — в отчёте: допуск сверит, о тех ли пунктах доказательства (#352).
        data["canon_points"] = listed
        claude_run.write_json(args.report, data)
        return data, verdict_v2(listed, data, args.report)


def cost_lines(report: Path, budget: str) -> list[str]:
    """Стоимость прогона из `<отчёт.json>` и строки о перерасходе — для тела PR."""
    try:
        cost = json.loads(report.read_text(encoding="utf-8")).get("total_cost_usd")
    except (OSError, ValueError, AttributeError):
        return []
    check = claude_run.budget_verdict(cost, budget, "проверка стоила")
    lines = [] if check["cost_usd"] is None else [f"стоимость {check['cost_usd']:.2f} USD"]
    if check["over_budget"]:
        lines.append(f"предупреждение: {check['warning']}")
    if check["ready_for_human"]:
        lines.append(
            f"ready-for-human: {check['warning']} — перерасход вдвое и больше, "
            "сессии тикета поставить ready-for-human с этой строкой"
        )
    return lines


def report_left(left: list[str], stream) -> None:
    if left:
        print("verify: /verify оставил в рабочем дереве: " + "; ".join(left), file=stream)


def main(argv: list[str] | None = None) -> int:
    parser = claude_run.parser("verify", __doc__.split("\n\n")[0])
    parser.add_argument(
        "--criteria-file", type=Path, required=True, help="критерии тикета для проверки"
    )
    args = parser.parse_args(argv)
    try:
        criteria = read_criteria(args.criteria_file)
        if not has_diff(args.base):
            print(f"verify: пропущено — в {args.base}...HEAD нет изменений")
            return 0
        before_state = tree_state()
        root = Path(git_out("rev-parse", "--show-toplevel"))
        check_tree(root, before_state)
        before = position()
        v2 = os.environ.get(TASK_ENV) == "1"
        listed = (
            points(criteria, args.report) if v2 else []
        )  # постановка не разобрана — до запуска, код 2
    except UsageError as exc:
        print(f"verify: {exc}", file=sys.stderr)
        return 2
    try:
        if v2:
            data, result = run_v2(args, criteria, listed, root)
        else:
            data = claude_run.run_claude(
                ["--permission-mode", PERMISSION_MODE, task(args.base, criteria)],
                args.report,
                args.max_budget_usd,
                SCHEMA,
            )
            result = verdict(data, args.report)
    except claude_run.ChildError as exc:
        print(f"verify: {exc}", file=sys.stderr)
        for line in cost_lines(args.report, args.max_budget_usd):
            print(f"verify: {line}", file=sys.stderr)
        report_left(leftovers(before_state, before), sys.stderr)
        return 1
    cost = data.get("total_cost_usd")
    cost_text = f"{cost:.2f}" if isinstance(cost, (int, float)) else "?"
    print(
        f"verify: /verify на {claude_run.MODEL} — {result} ({cost_text} USD); "
        f"что проверено — {args.report.with_suffix('.md')}"
    )
    for line in cost_lines(args.report, args.max_budget_usd)[1:]:
        print(f"verify: {line}")
    report_left(leftovers(before_state, before), sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
