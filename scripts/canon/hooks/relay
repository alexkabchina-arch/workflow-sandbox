#!/usr/bin/env python3
"""relay — стандартный хук перед коммитом воркфлоу (#463): `relay <вид хука> [аргументы git…]`,
вся логика — `commit_checks.py` рядом.

Зовут его скрипты переходника `canon-hooks/` в рабочей копии тикета (ставит подготовка,
`session-start`): у `pre-commit` — стандартные проверки, затем свой хук проекта того же вида. Git
зовёт хук из корня рабочей копии. Файл вендорится из канона `alexkabchina-arch/workflow`: руками
не править. Только стандартная библиотека Python 3.
"""

import sys
import types
from pathlib import Path

path = Path(__file__).resolve().parent / "commit_checks.py"
checks = types.ModuleType("canon_commit_checks_relay")
checks.__file__ = str(path)
exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), checks.__dict__)
sys.exit(checks.relay(sys.argv[1], sys.argv[2:], Path.cwd()))
