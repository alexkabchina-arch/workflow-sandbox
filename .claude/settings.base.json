{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_TIMEOUT_MS": "2700000"
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api *branches/*/protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api graphql *BranchProtectionRule*)",
      "Bash(gh api graphql *RepositoryRuleset*)",
      "Bash(gh api *statuses*)",
      "Edit(/**/.claude/settings.json)",
      "Edit(/**/.claude/settings.local.json)",
      "Edit(/**/.claude/settings.base.json)",
      "Edit(/**/.canon.lock)",
      "Edit(/**/.claude/canon/**)",
      "Edit(/**/.claude/skills/code-review/**)",
      "Edit(/**/.claude/skills/diagnosing-bugs/**)",
      "Edit(/**/.claude/skills/domain-modeling/**)",
      "Edit(/**/.claude/skills/grill-with-docs/**)",
      "Edit(/**/.claude/skills/grilling/**)",
      "Edit(/**/.claude/skills/implement/**)",
      "Edit(/**/.claude/skills/implement-spec/**)",
      "Edit(/**/.claude/skills/pr/**)",
      "Edit(/**/.claude/skills/retro/**)",
      "Edit(/**/.claude/skills/setup-matt-pocock-skills/**)",
      "Edit(/**/.claude/skills/ship/**)",
      "Edit(/**/.claude/skills/start/**)",
      "Edit(/**/.claude/skills/tdd/**)",
      "Edit(/**/.claude/skills/tickets/**)",
      "Edit(/**/.claude/skills/to-spec/**)",
      "Edit(/**/.claude/skills/to-tickets/**)",
      "Edit(/**/.claude/skills/triage/**)",
      "Edit(/**/.claude/skills/wayfinder/**)",
      "Edit(/**/.claude/skills/writing-for-agents/**)",
      "Edit(/**/.github/workflows/dependabot-review.yml)",
      "Edit(/**/.github/workflows/review-guard.yml)",
      "Edit(/**/.github/workflows/review-guard-rerun.yml)",
      "Edit(/**/matt-skills.txt)",
      "Edit(/**/matt-skills.lock.json)",
      "Edit(/**/scripts/canon/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/canon/stop-check",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
